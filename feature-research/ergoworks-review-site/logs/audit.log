+            <thead><tr><th scope="col">Phase</th><th scope="col">Work</th><th scope="col">Decision enabled</th></tr></thead>
+            <tbody>
+              {workPlan.map(([phase, work, decision]) => <tr key={phase}><th scope="row">{phase}</th><td>{work}</td><td>{decision}</td></tr>)}
