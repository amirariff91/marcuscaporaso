     5	.page h1,.page h2,.page h3,.page p { text-wrap:pretty; }
     6	.hero { min-height:100svh; padding:0 clamp(1.25rem,5vw,5rem) 3rem; background:var(--ink); color:#f7fbf9; display:flex; flex-direction:column; position:relative; }
     7	.hero::after { content:""; position:absolute; width:min(35rem,70vw); aspect-ratio:1; right:-12rem; top:10rem; border:1px solid #3b5a51; border-radius:50%; box-shadow:0 0 0 5rem #173029,0 0 0 5.05rem #3b5a51,0 0 0 10rem #132923; pointer-events:none; }
