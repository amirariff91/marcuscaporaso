   108	.shellBrand { display:flex; align-items:center; gap:.55rem; color:#f7fbf9; font-weight:600; font-size:.92rem; letter-spacing:-.01em; text-decoration:none; flex:none; }
   109	.shellBrand>span { width:1.95rem; height:1.95rem; display:grid; place-items:center; border-radius:50%; background:#d9f45b; color:var(--ink); font-family:var(--font-barlow); font-size:.68rem; font-weight:800; }
   110	.shellPrivate { display:flex; gap:.4rem; align-items:center; color:#c5d5cf; font-size:.68rem; font-weight:700; text-transform:uppercase; letter-spacing:.09em; flex:none; }
   111	.shellPrivate svg { color:#d9f45b; }
