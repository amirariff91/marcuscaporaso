.mockBody h3 { font-size:clamp(2rem,4vw,3.5rem);line-height:1;letter-spacing:-.03em;max-width:11ch; }.mockBody p { color:#596963;max-width:36ch;line-height:1.55;margin:1.3rem 0; }
