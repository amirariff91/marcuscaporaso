.wordmark>span { width:2.2rem; height:2.2rem; display:grid; place-items:center; border-radius:50%; background:#d9f45b; color:var(--ink); font-family:var(--font-barlow); font-size:.75rem; font-weight:800; }
.private { display:flex; gap:.45rem; align-items:center; color:#b8c9c3; font-size:.82rem; }
.heroGrid { width:min(1200px,100%); margin:auto; display:grid; grid-template-columns:minmax(0,1.35fr) minmax(18rem,.65fr); align-items:end; gap:clamp(3rem,8vw,8rem); position:relative; z-index:1; padding:5rem 0; }
.kicker { color:#d9f45b; font-size:.8rem; font-weight:700; letter-spacing:.08em; text-transform:uppercase; margin-bottom:1.5rem; }
.hero h1 { max-width:13ch; font-size:clamp(3.25rem,7vw,6rem); line-height:.96; letter-spacing:-.035em; text-wrap:balance; }
.heroCopy { max-width:55ch; margin-top:2rem; color:#c6d3ce; font-size:clamp(1.05rem,1.5vw,1.25rem); line-height:1.65; }
.summary { border-top:3px solid #d9f45b; padding-top:1.5rem; }
.summary>p { color:#9eb2aa; font-size:.78rem; text-transform:uppercase; letter-spacing:.08em; }
.summary h2 { margin:.8rem 0 1.6rem; font-size:1.35rem; line-height:1.3; }
.summary ul,.lpCopy ul { list-style:none; display:grid; gap:.75rem; }
.summary li,.lpCopy li { display:flex; gap:.65rem; align-items:flex-start; color:#c6d3ce; font-size:.92rem; }
.summary li svg { color:#d9f45b; flex:none; }
.scrollCue { align-self:flex-start; display:flex; gap:.5rem; align-items:center; color:#9eb2aa; font-size:.78rem; text-decoration:none; position:relative; z-index:1; padding:.5rem .25rem; transition:color .25s cubic-bezier(.19,1,.22,1); }
.scrollCue:hover { color:#d9f45b; }
.scrollCue:focus-visible { outline:2px solid #d9f45b; outline-offset:3px; color:#d9f45b; }
@media (prefers-reduced-motion:no-preference) {
  :global(html) { scroll-behavior:smooth; }
  .hero h1,.heroCopy,.kicker,.summary { animation:heroRise .9s cubic-bezier(.19,1,.22,1) backwards; }
  .heroCopy { animation-delay:.12s; }
  .summary { animation-delay:.24s; }
}
@keyframes heroRise { from { opacity:0; transform:translateY(1.25rem); } to { opacity:1; transform:none; } }
.sectionNav { position:sticky; top:0; z-index:20; display:flex; gap:.35rem; align-items:center; overflow-x:auto; scrollbar-width:none; background:rgba(8,20,16,.92); backdrop-filter:blur(10px); border-bottom:1px solid #24413a; padding:.55rem clamp(1rem,4vw,2.5rem); }
.sectionNav::-webkit-scrollbar { display:none; }
.sectionNav a { flex:none; color:#b8c9c3; font-size:.82rem; font-weight:600; letter-spacing:-.01em; text-decoration:none; padding:.4rem .7rem; border-radius:999px; white-space:nowrap; transition:color .2s cubic-bezier(.19,1,.22,1),background .2s cubic-bezier(.19,1,.22,1); }
.sectionNav a:hover { color:var(--ink); background:#d9f45b; }
.sectionNav a:focus-visible { outline:2px solid #d9f45b; outline-offset:2px; }
.page section[id] { scroll-margin-top:3.5rem; }
