/bin/zsh -lc "rg -n -i 'sticky|one second|48|200KB|AVIF|WebP|100%|noindex|canonical|LCP|hero|progress|validation|duplicate|return to|client sign-off|deliverable|Australia-wide|Australia-wide|individual|equipment|free text|phone|call|caveat' docs/ergoworks-consulting/appendices/A-landing-page-copy.md | sed -n '1,260p'; nl -ba src/app/ergoworks/plan/landing-page/page.tsx | sed -n '200,340p'" in /Users/amirariff/projects/growthos/marcuscaporaso
