     1	import type { NextRequest } from "next/server";
     2	
     3	// Streams the confidential review-pack PDF from a private Cloudflare R2 bucket
     4	// (via a Basic-auth-gated Worker) WITHOUT the file ever entering git or public/.
     5	// This route already sits behind the /ergoworks/plan/* proxy gate, so the
     6	// incoming request carries the authenticated user's credentials; we forward the
     7	// same Authorization header to the Worker, which validates it against the same
     8	// creds and returns the object. Result: one auth prompt, same origin, nothing
     9	// confidential committed to the repo.
    10	export const runtime = "nodejs";
    11	export const dynamic = "force-dynamic";
    12	
    13	const WORKER_URL = "https://ergoworks-pack.ariffseh2824.workers.dev";
    14	
    15	export async function GET(request: NextRequest) {
    16	  const auth = request.headers.get("authorization");
    17	  if (!auth) {
    18	    // The proxy gate should have enforced this already; belt and braces.
    19	    return new Response("Authentication required.", {
    20	      status: 401,
    21	      headers: {
    22	        "WWW-Authenticate": 'Basic realm="ErgoWorks Plan", charset="UTF-8"',
    23	        "Cache-Control": "no-store",
    24	      },
    25	    });
    26	  }
    27	
    28	  let upstream: Response;
    29	  try {
    30	    upstream = await fetch(WORKER_URL, {
    31	      headers: { authorization: auth },
    32	      cache: "no-store",
    33	    });
    34	  } catch {
    35	    return new Response("The review pack is temporarily unavailable.", {
    36	      status: 502,
    37	      headers: { "Cache-Control": "no-store" },
    38	    });
    39	  }
    40	
    41	  const headers = new Headers();
    42	  headers.set("Content-Type", upstream.headers.get("content-type") ?? "application/pdf");
    43	  headers.set(
    44	    "Content-Disposition",
    45	    upstream.headers.get("content-disposition") ??
    46	      'attachment; filename="ErgoWorks-Consulting-Review-Pack.pdf"',
    47	  );
    48	  const len = upstream.headers.get("content-length");
    49	  if (len) headers.set("Content-Length", len);
    50	  headers.set("Cache-Control", "private, no-store");
    51	  headers.set("Vary", "Authorization");
    52	
    53	  return new Response(upstream.body, { status: upstream.status, headers });
    54	}

