# Set these in Coolify BEFORE building.
# NEXT_PUBLIC_* vars are baked at build time — changing them requires a full rebuild + redeploy.

# The deployed URL of this site (used for SEO metadata and CORS allowedOrigins)
APP_URL=https://marcuscaporaso.cepathosting.com

# The GrowthOS diagnostic tool URL (cross-link target)
NEXT_PUBLIC_GROWTHOS_URL=https://growthops.cepathosting.com

# Marcus's Calendly booking link — confirm the exact slug with Marcus before launch
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/mjc-growth/strategy

# Access gate for the private ErgoWorks review pack at /ergoworks/plan/*.
# Server-only (do NOT prefix NEXT_PUBLIC_). Read at runtime — rotating them needs
# no rebuild, only a restart. Set BOTH in Coolify runtime env before sharing the URL.
# If either is unset the gate fails closed (every /ergoworks/plan/* request → 401).
ERGOWORKS_PLAN_USER=changeme
ERGOWORKS_PLAN_PASSWORD=changeme

# ErgoEquip SEO review gate (/ergoequip/seo) — a SEPARATE client, so separate
# credentials from ErgoWorks. If either is unset the gate fails closed (every
# /ergoequip/seo request → 401). Set BOTH in Coolify runtime env before sharing the URL.
ERGOEQUIP_REVIEW_USER=changeme
ERGOEQUIP_REVIEW_PASSWORD=changeme
